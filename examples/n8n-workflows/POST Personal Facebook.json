    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('setupData').item.json.driverUrl }}/evaluate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "=pageId",
              "value": "={{ $('New tab').item.json.pageId }}"
            },
            {
              "name": "fn",
              "value": "async () => {\n  const el = document.querySelectorAll('.displayed>div>div>div[data-mcomponent=\"MContainer\"][data-focusable=\"true\"][tabindex=\"0\"]')[3];\n  if (el) el.click();\n\n  // Đợi URL đổi\n  await new Promise(resolve => {\n    const check = () => {\n      if (window.location.href.includes('story.php?story_fbid')) {\n        resolve();\n      } else {\n        requestAnimationFrame(check);\n      }\n    };\n    check();\n  });\n\n  return window.location.href;\n}"
            }
          ]
        },
        "options": {}
      },
