{
  "name": "puppeteer-rest-api",
  "version": "1.3.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/worker.js",
    "bns": "tsc && node dist/worker.js",
    "obfbk": "npx javascript-obfuscator dist/worker.min.js --output dist/worker-obf.js",
    "obf": "npx javascript-obfuscator dist/worker.min.js --output dist/worker-obf.js --selfDefending false --deadCodeInjection false",
    "cpgo": "copy packer.go dist\\",
    "esb": "esbuild src/worker.ts --bundle --platform=node --minify --keep-names --outfile=dist/worker.min.js",
    "exe": "go build -ldflags=\"-s -w\" -o dist/auto.exe dist/packer.go",
    "make": "npm run esb && npm run cpgo && npm run exe"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "chrome-paths": "^1.0.1",
    "express": "^5.1.0",
    "markdown-it": "^14.1.0",
    "puppeteer-core": "^24.23.0",
    "socket.io-client": "^4.8.1",
    "ua-parser-js": "^2.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.6.2",
    "esbuild": "^0.25.11",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
